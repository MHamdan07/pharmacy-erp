// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pharmacy {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  email            String            @unique
  phone            String?
  address          String?
  status           String            @default("active") // active, suspended, expired
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branches         Branch[]
  users            User[]
  categories       Category[]
  suppliers        Supplier[]
  medicines        Medicine[]
  batches          Batch[]
  customers        Customer[]
  sales            Sale[]
  stockTransfers   StockTransfer[]
  subscriptions    Subscription[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  backups          Backup[]
}

model Branch {
  id               String            @id @default(uuid())
  pharmacyId       String
  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name             String
  code             String
  address          String?
  phone            String?
  type             String            @default("Main") // Main, Branch, Warehouse
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  batches          Batch[]
  sales            Sale[]
  outgoingTransfers StockTransfer[]  @relation("OutgoingTransfers")
  incomingTransfers StockTransfer[]  @relation("IncomingTransfers")

  @@unique([pharmacyId, code])
}

model User {
  id                  String         @id @default(uuid())
  pharmacyId          String?
  pharmacy            Pharmacy?      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name                String
  email               String         @unique
  password            String
  role                String         @default("Pharmacist") // SuperAdmin, Owner, Admin, Manager, Pharmacist, Cashier, Inventory Manager
  is2FAEnabled        Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockUntil           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sales               Sale[]
  requestedTransfers  StockTransfer[] @relation("RequestedTransfers")
  auditLogs           AuditLog[]
}

model Category {
  id          String     @id @default(uuid())
  pharmacyId  String
  pharmacy    Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  medicines   Medicine[]

  @@unique([pharmacyId, name])
}

model Supplier {
  id            String     @id @default(uuid())
  pharmacyId    String
  pharmacy      Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  medicines     Medicine[]
  batches       Batch[]
}

model Medicine {
  id             String       @id @default(uuid())
  pharmacyId     String
  pharmacy       Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name           String
  genericName    String?
  barcode        String?
  sku            String?
  minStockLevel  Int          @default(10)
  unitPrice      Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  batches        Batch[]
  saleItems      SaleItem[]

  @@unique([pharmacyId, sku])
}

model Batch {
  id             String         @id @default(uuid())
  pharmacyId     String
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  medicineId     String
  medicine       Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  batchNumber    String
  quantity       Int            @default(0)
  purchasePrice  Float          @default(0)
  sellingPrice   Float          @default(0)
  expiryDate     DateTime
  mfgDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  saleItems      SaleItem[]
  transferItems  TransferItem[]

  @@unique([branchId, medicineId, batchNumber])
}

model Customer {
  id            String     @id @default(uuid())
  pharmacyId    String
  pharmacy      Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sales         Sale[]
}

model Sale {
  id            String     @id @default(uuid())
  pharmacyId    String
  pharmacy      Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierId     String?
  cashier       User?      @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceNumber String     @unique
  subtotal      Float
  discount      Float      @default(0)
  tax           Float      @default(0)
  totalAmount   Float
  paymentMethod String     @default("cash") // cash, card, mobile, split
  status        String     @default("completed") // completed, refunded
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         SaleItem[]
}

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime  @default(now())
}

model StockTransfer {
  id            String         @id @default(uuid())
  pharmacyId    String
  pharmacy      Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fromBranchId  String
  fromBranch    Branch         @relation("OutgoingTransfers", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranchId    String
  toBranch      Branch         @relation("IncomingTransfers", fields: [toBranchId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?          @relation("RequestedTransfers", fields: [requestedById], references: [id], onDelete: SetNull)
  status        String         @default("pending") // pending, approved, dispatched, completed, cancelled
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         TransferItem[]
}

model TransferItem {
  id            String        @id @default(uuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity      Int
  createdAt     DateTime      @default(now())
}

model Subscription {
  id                 String    @id @default(uuid())
  pharmacyId         String
  pharmacy           Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  planName           String    @default("Professional") // Starter, Professional, Enterprise
  status             String    @default("active") // active, cancelled, expired, suspended, trial
  startDate          DateTime  @default(now())
  endDate            DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(uuid())
  pharmacyId  String?
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

model Notification {
  id          String    @id @default(uuid())
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  type        String    @default("info") // expiry, low_stock, transfer, system
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Backup {
  id          String    @id @default(uuid())
  pharmacyId  String
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  fileName    String
  fileSize    Int
  status      String    @default("completed")
  createdAt   DateTime  @default(now())
}
