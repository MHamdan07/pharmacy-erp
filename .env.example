# -----------------------------------------------------------------------------
# Pharmacy ERP Environment Variables Configuration
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Prisma Postgres for Production / Vercel Deployment)
# Accelerated Prisma Postgres URL (Vercel / Prisma Data Platform):
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_prisma_api_key"

# Direct PostgreSQL Connection URL (used for migrations and seeding):
DIRECT_URL="postgres://postgres:your_password@ep-sample-12345.us-east-1.aws.neon.tech/neondb?sslmode=require"

# CORS & Allowed Frontends
CLIENT_URLS=https://your-vercel-domain.vercel.app

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_32_chars
