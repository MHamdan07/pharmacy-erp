# -----------------------------------------------------------------------------
# Pharmacy ERP Environment Variables Configuration
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas for Production / Vercel Deployment)
# Replace with your Cloud MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pharmacy_erp?retryWrites=true&w=majority

# CORS & Allowed Frontends
CLIENT_URLS=https://your-vercel-domain.vercel.app

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_32_chars
