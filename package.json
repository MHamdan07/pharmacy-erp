{
  "name": "pharmacy-erp",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.4.0",
    "prisma": "6.4.0"
  }
}
