{
  "name": "pharmacy-erp",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.5.0",
    "mongoose": "^8.3.4",
    "nodemailer": "^6.9.13",
    "prisma": "^6.4.0"
  }
}
